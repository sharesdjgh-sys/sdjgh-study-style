NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Neon 연결 문자열. 서버에서만 사용합니다.
DATABASE_URL=
# 카카오 JavaScript 키와 운영 도메인을 함께 설정하세요.
NEXT_PUBLIC_KAKAO_JS_KEY=
# 카카오 로그인용 서버 전용 키. JavaScript 키와 서로 다릅니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 리다이렉트 URI: NEXT_PUBLIC_SITE_URL + /api/auth/kakao/callback
# Vercel Cron 요청 검증용 임의의 긴 비밀 값
CRON_SECRET=
# 공개 문의 메일 (비워 두면 연락처를 표시하지 않습니다.)
NEXT_PUBLIC_CONTACT_EMAIL=
