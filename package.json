{
  "name": "study-style-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json README.md"
  },
  "dependencies": {
    "@iconify-json/solar": "1.2.13",
    "@neondatabase/serverless": "1.1.0",
    "next": "16.3.7",
    "pretendard": "1.3.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
